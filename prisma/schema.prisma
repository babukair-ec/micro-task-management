datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id              Int                      @id @default(autoincrement())
  title           String                   @db.VarChar(255)
  description     String?                  @db.Text
  creator_id      Int
  current_owner_id Int?
  status          String                   @default("DRAFT") @db.VarChar(50)
  priority        String                   @default("MEDIUM") @db.VarChar(20)
  assignment_mode String                   @default("SELF") @db.VarChar(20)
  due_date        DateTime?                @db.Timestamptz
  created_at      DateTime                 @default(now()) @db.Timestamptz
  started_at      DateTime?                @db.Timestamptz
  completed_at    DateTime?                @db.Timestamptz

  eligibilities   TaskClaimEligibility[]
  assignment_histories TaskAssignmentHistory[]
  requests        TaskRequest[]

  @@map("tasks")
}

model TaskClaimEligibility {
  id          Int      @id @default(autoincrement())
  task_id     Int
  employee_id Int
  created_at  DateTime @default(now()) @db.Timestamptz

  task        Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, employee_id])
  @@map("task_claim_eligibilities")
}

model TaskAssignmentHistory {
  id          Int       @id @default(autoincrement())
  task_id     Int
  employee_id Int
  assigned_at DateTime  @default(now()) @db.Timestamptz
  ended_at    DateTime? @db.Timestamptz
  reason      String    @db.VarChar(100)

  task        Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_assignment_histories")
}

model TaskRequest {
  id                   Int       @id @default(autoincrement())
  task_id              Int
  requester_id         Int
  requested_employee_id Int
  status               String    @default("PENDING") @db.VarChar(50)
  created_at           DateTime  @default(now()) @db.Timestamptz
  responded_at         DateTime? @db.Timestamptz

  task                 Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_requests")
}

model EmployeeCache {
  id         Int      @id
  username   String   @db.VarChar(150)
  full_name  String?  @db.VarChar(255)
  email      String?  @db.VarChar(255)
  department String?  @db.VarChar(100)
  job_title  String?  @db.VarChar(100)
  is_active  Boolean  @default(true)
  updated_at DateTime @default(now()) @db.Timestamptz

  @@map("employee_cache")
}
